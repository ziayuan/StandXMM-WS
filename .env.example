# StandX Authentication
# API Key (Usually the long JWT Token or Access Key)
STANDX_API_KEY=your_api_key_here

# API Secret (Ed25519 Private Key - Base58 or Base64 Encoded)
STANDX_API_SECRET=your_api_secret_here

# Chain ID (e.g. arbitrum, bsc)
STANDX_CHAIN=arbitrum

# Telegram Alerts (Optional)
# Get Chat ID from @userinfobot, Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
